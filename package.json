{
  "name": "@triforce-heroes/triforce-core",
  "version": "1.0.0",
  "description": "Triforce Core libraries.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./Array": {
      "types": "./dist/Array.d.mts",
      "default": "./dist/Array.mjs"
    },
    "./Buffer": {
      "types": "./dist/Buffer.d.mts",
      "default": "./dist/Buffer.mjs"
    },
    "./BufferBuilder": {
      "types": "./dist/BufferBuilder.d.mts",
      "default": "./dist/BufferBuilder.mjs"
    },
    "./BufferConsumer": {
      "types": "./dist/BufferConsumer.d.mts",
      "default": "./dist/BufferConsumer.mjs"
    },
    "./Cache": {
      "types": "./dist/Cache.d.mts",
      "default": "./dist/Cache.mjs"
    },
    "./Console": {
      "types": "./dist/Console.d.mts",
      "default": "./dist/Console.mjs"
    },
    "./ConsoleHexadecimal": {
      "types": "./dist/ConsoleHexadecimal.d.mts",
      "default": "./dist/ConsoleHexadecimal.mjs"
    },
    "./Debugger": {
      "types": "./dist/Debugger.d.mts",
      "default": "./dist/Debugger.mjs"
    },
    "./Encoding": {
      "types": "./dist/Encoding.d.mts",
      "default": "./dist/Encoding.mjs"
    },
    "./Hash": {
      "types": "./dist/Hash.d.mts",
      "default": "./dist/Hash.mjs"
    },
    "./Number": {
      "types": "./dist/Number.d.mts",
      "default": "./dist/Number.mjs"
    },
    "./Path": {
      "types": "./dist/Path.d.mts",
      "default": "./dist/Path.mjs"
    },
    "./types/ByteOrder": {
      "types": "./dist/types/ByteOrder.d.mts",
      "default": "./dist/types/ByteOrder.mjs"
    },
    "./types/PrintHexadecimalPreset": {
      "types": "./dist/types/PrintHexadecimalPreset.d.mts",
      "default": "./dist/types/PrintHexadecimalPreset.mjs"
    }
  },
  "scripts": {
    "build": "bun run lint && bun run test && tsdown",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "oxlint": "oxlint ./src ./tests",
    "oxlint:fix": "oxlint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "json-diff": "^1.0.6"
  },
  "devDependencies": {
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@types/json-diff": "^1.0.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "commander": "^15.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "strip-ansi": "^7.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
